SUPABASE_URL=https://your-project.supabase.co
SUPABASE_PUBLISHABLE_KEY=sb_publishable_or_anon_key
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key
DATABASE_URL=postgresql+psycopg://postgres.your-project:[YOUR-PASSWORD]@aws-0-region.pooler.supabase.com:5432/postgres?sslmode=require
PINECONE_API_KEY=your-pinecone-api-key
PINECONE_INDEX_NAME=your-index-name
REDIS_URL=redis://localhost:6379/0
FRONTEND_ORIGINS=http://localhost:5173
MAX_PDF_SIZE_BYTES=26214400
# PDF processing limits; OCR requires the Tesseract OS executable.
PDF_PROCESSING_MAX_PAGES=500
PDF_TEXT_MIN_CHARACTERS=35
PDF_OCR_DPI=200
PDF_OCR_TIMEOUT_SECONDS=30
# Signed download links expire after five minutes by default.
REPORT_DOWNLOAD_URL_TTL_SECONDS=300
# Optional; set only if tesseract is not discoverable through PATH.
# TESSERACT_CMD=C:\Program Files\Tesseract-OCR\tesseract.exe
